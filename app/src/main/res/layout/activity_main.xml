<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="A screensaver and slideshow for your own photos and videos."
            android:textColor="#A9B1BA"
            android:textSize="16sp" />

        <!-- Source -->
        <TextView
            style="@style/SectionTitle"
            android:text="Where are your photos?" />

        <RadioGroup
            android:id="@+id/source_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radio_folder"
                style="@style/Option"
                android:text="Pick a folder (phones, tablets, most TVs)" />

            <RadioButton
                android:id="@+id/radio_library"
                style="@style/Option"
                android:text="Search the media library (use if the folder picker doesn't work)" />

            <RadioButton
                android:id="@+id/radio_network"
                style="@style/Option"
                android:text="Network folder on a PC or NAS (also works for Dropbox, OneDrive or Google Drive folders synced to that PC)" />

            <RadioButton
                android:id="@+id/radio_youtube"
                style="@style/Option"
                android:text="YouTube playlist or channel (public and unlisted videos)" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/folder_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/choose_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose folder…" />

            <TextView
                android:id="@+id/folder_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#A9B1BA"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Only show folders whose path contains (leave blank for everything):"
                android:textColor="#A9B1BA"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/filter_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Slideshow"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B737C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/network_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Hint"
                android:text="Shared folder (PC name or IP address, share name, then any sub-folder):" />

            <EditText
                android:id="@+id/net_path"
                style="@style/Field"
                android:hint="\\\\MYPC\\Photos\\Slideshow   or   \\\\192.168.1.20\\Photos"
                android:inputType="textUri" />

            <TextView
                style="@style/Hint"
                android:text="Username (for a Windows PC, usually your Microsoft account email). Leave blank for guest access:" />

            <EditText
                android:id="@+id/net_user"
                style="@style/Field"
                android:hint="Username"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/net_password"
                style="@style/Field"
                android:hint="Password"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/net_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Test connection" />

            <TextView
                android:id="@+id/net_status"
                style="@style/Hint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/youtube_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Hint"
                android:text="Paste a playlist link, a channel link, or a channel @handle. A channel plays its public uploads; for unlisted videos, put them in a playlist and paste that playlist's link. Private videos can't be played outside YouTube. Needs internet; YouTube may show ads." />

            <EditText
                android:id="@+id/youtube_link"
                style="@style/Field"
                android:hint="https://www.youtube.com/playlist?list=…   or   @yourchannel"
                android:inputType="textUri" />
        </LinearLayout>

        <!-- Timing -->
        <TextView
            style="@style/SectionTitle"
            android:text="Timing" />

        <TextView
            android:id="@+id/label_interval"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/seek_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/label_video"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/seek_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- Options -->
        <TextView
            style="@style/SectionTitle"
            android:text="Options" />

        <Switch android:id="@+id/switch_shuffle" style="@style/Option" android:text="Shuffle" />
        <Switch android:id="@+id/switch_videos" style="@style/Option" android:text="Include videos" />
        <Switch android:id="@+id/switch_mute" style="@style/Option" android:text="Mute videos" />
        <Switch android:id="@+id/switch_zoom" style="@style/Option" android:text="Slow zoom on photos" />
        <Switch android:id="@+id/switch_fill" style="@style/Option" android:text="Crop photos to fill the screen" />
        <Switch android:id="@+id/switch_clock" style="@style/Option" android:text="Show clock and date" />
        <Switch android:id="@+id/switch_date" style="@style/Option" android:text="Show the date each photo or video was taken" />
        <Switch android:id="@+id/switch_location" style="@style/Option" android:text="Show where photos were taken (needs internet for place names)" />

        <!-- Actions -->
        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="▶  Start slideshow now" />

        <Button
            android:id="@+id/screensaver_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set as screensaver…" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/help_text"
            android:textColor="#A9B1BA"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
